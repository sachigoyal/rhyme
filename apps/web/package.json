{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "build": "pnpm generate:brand && pnpm generate:email-logo && pnpm generate:og && vite build && pnpm generate:404 && pnpm check:seo",
    "generate:404": "node scripts/generate-404.mjs",
    "generate:og": "node --experimental-strip-types scripts/generate-og.mjs",
    "check:seo": "node --experimental-strip-types scripts/check-seo.mjs",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "check": "oxfmt --check .",
    "check-types": "tsr generate && tsc --noEmit",
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "test:ui": "node --test tests/*.browser.mjs",
    "generate:brand": "node --experimental-strip-types scripts/generate-brand.mjs",
    "generate:email-logo": "node scripts/generate-email-logo.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@cloudflare/ai-chat": "catalog:",
    "@rhyme/hooks": "workspace:*",
    "@rhyme/trpc-client": "workspace:*",
    "@rhyme/ui": "workspace:*",
    "@shadcn/react": "catalog:",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "agents": "catalog:",
    "ai": "catalog:",
    "api": "workspace:*",
    "better-auth": "catalog:",
    "elkjs": "catalog:",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.48.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "tailwindcss": "^4.1.18",
    "tinycolor2": "catalog:",
    "tldraw": "^5.4.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@resvg/resvg-js": "catalog:",
    "@tanstack/router-cli": "^1.132.0",
    "@types/tinycolor2": "catalog:",
    "@types/node": "^22.10.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.1",
    "fontkit": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.0.0",
    "playwright": "^1.63.0"
  }
}
