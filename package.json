{
  "name": "rhyme",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @rhyme/db db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "test": "pnpm --filter api test && pnpm --filter @rhyme/hooks test && pnpm --filter web test",
    "deploy": "pnpm --filter web build && pnpm --filter api db:migrate:production && pnpm --filter api deploy:production"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.5",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  }
}
